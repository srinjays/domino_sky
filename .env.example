# Copy to .env and fill in. Never commit .env.
# Optional AI provider. Groq takes priority when both keys are set.
# With both keys blank, the simulation engine recommends the plan.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Server
PORT=8080
# Set only when all incoming requests traverse the same trusted proxy chain.
TRUST_PROXY_HOPS=0
# Comma-separated list of allowed CORS origins (dev UI runs on 5173)
CORS_ORIGINS=http://localhost:5173
# Path to the dataset JSON (relative to repo root or absolute)
DATASET_PATH=data/dataset.json
# AI request timeout in milliseconds
AI_TIMEOUT_MS=15000

